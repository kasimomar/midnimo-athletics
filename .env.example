# Optional HTTPS video URL; leave blank for the gradient hero.
NEXT_PUBLIC_HERO_VIDEO_URL=
# Public build-time values, visible in browser bundles. Never put secrets here.

# Server-side canonical public origin for search and share previews (HTTPS).
# Locally defaults to localhost; Vercel defaults to its production domain.
SITE_URL=

# Server-only Resend configuration. Never prefix credentials with NEXT_PUBLIC_.
# Marketplace provisioning supplies the key and verified sending domain.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Enable only after sender verification and preview checks. Rebuild after changing.
CONTACT_FORM_ENABLED=false
